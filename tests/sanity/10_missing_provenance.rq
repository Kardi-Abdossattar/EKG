# ============================================================
# Sanity Check: Missing Provenance Metadata
# Description: Detects entities without prov:generatedAtTime (no lineage timestamp)
# Expected: May have results (provenance is recommended but not always required)
# Severity: Warning
# ============================================================

PREFIX ex: <http://example.com/schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?entity ?type ?name
WHERE {
    ?entity a ?type .
    FILTER(?type IN (ex:Person, ex:OrgUnit, ex:Product, ex:Project, ex:Asset))

    OPTIONAL { ?entity ex:name ?name }
    OPTIONAL { ?entity ex:fullName ?fullName }

    FILTER NOT EXISTS { ?entity prov:generatedAtTime ?timestamp }

    BIND(COALESCE(?name, ?fullName, "N/A") AS ?name)
}
ORDER BY ?type ?name
LIMIT 100
