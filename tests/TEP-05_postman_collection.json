    {
      "name": "1. Viewer Tests (alice.viewer)",
      "item": [
        {
          "name": "GET /ekg/persons (SUCCESS - viewer can read)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Only Public and Internal data visible\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    jsonData.data.forEach(function(person) {",
                  "        if (person.label) {",
                  "            var labelValue = person.label.value.split('#').pop();",
                  "            pm.expect(['Public', 'Internal']).to.include(labelValue);",
                  "        }",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{viewer_token}}"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/ekg/persons?limit=50",
              "host": ["{{api_url}}"],
              "path": ["ekg", "persons"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "GET /ekg/quarantine (FAIL - viewer forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Error message mentions role requirement\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('curator');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{viewer_token}}"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/ekg/quarantine",
              "host": ["{{api_url}}"],
              "path": ["ekg", "quarantine"]
            }
          }
        },
        {
          "name": "POST /ekg/sparql/update (FAIL - viewer forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
