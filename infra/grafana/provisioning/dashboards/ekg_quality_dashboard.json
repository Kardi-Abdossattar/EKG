{
  "title": "EKG Quality Monitor",
  "tags": ["ekg", "quality", "shacl", "data-integrity"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Quality Score",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "ekg_quality_score",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 50, "color": "orange"},
              {"value": 80, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SHACL Violations (Critical)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "ekg_shacl_violations{severity=\"Violation\"}",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Triples",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "ekg_triple_count",
          "refId": "A",
          "legendFormat": "{{graph}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last Quality Check",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "time() - ekg_last_quality_check_timestamp",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 300, "color": "yellow"},
              {"value": 3600, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Quality Score Evolution",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "ekg_quality_score",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SHACL Violations Over Time",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "ekg_shacl_violations{severity=\"Violation\"}",
          "refId": "A",
          "legendFormat": "Violations"
        },
        {
          "expr": "ekg_shacl_violations{severity=\"Warning\"}",
          "refId": "B",
          "legendFormat": "Warnings"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Violations"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Warnings"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Sanity Checks - Issues Detected",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "ekg_sanity_check_issues",
          "refId": "A",
          "legendFormat": "{{check_name}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Entity Distribution by Type",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "ekg_entities_by_type",
          "refId": "A",
          "legendFormat": "{{entity_type}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]},
        "pieType": "donut"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Triple Count Evolution",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "ekg_triple_count",
          "refId": "A",
          "legendFormat": "{{graph}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5
          }
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingestion Latency",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "ekg_ingest_latency_seconds",
          "refId": "A",
          "legendFormat": "{{repository}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 60, "color": "yellow"},
              {"value": 300, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Sanity Checks Summary",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 6},
      "targets": [
        {
          "expr": "ekg_sanity_check_issues",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Value", "desc": true}]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "color-background"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
            "renameByName": {
              "check_name": "Check Name",
              "repository": "Repository",
              "Value": "Issues Detected"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Quarantine - Anomalies",
      "description": "TEP-03.5: Entités en quarantaine nécessitant curation",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "ekg_quarantine_total",
          "refId": "A",
          "legendFormat": "Anomalies en attente"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 10, "color": "orange"},
              {"value": 50, "color": "red"}
            ]
          }
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "repository",
        "type": "query",
        "label": "Repository",
        "query": "label_values(ekg_quality_score, repository)",
        "current": {
          "selected": true,
          "text": "ekg",
          "value": "ekg"
        },
        "multi": false,
        "includeAll": false,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Quality Alerts",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=~\"EKG.*\"}",
        "titleFormat": "{{ alertname }}",
        "textFormat": "{{ annotations.summary }}"
      }
    ]
  }
}

