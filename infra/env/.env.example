# =============================================================================
# EKG Sécurisé & Fiable - Configuration d'environnement
# =============================================================================
# IMPORTANT: Copier ce fichier vers .env et modifier les valeurs selon votre environnement
# Ne JAMAIS committer le fichier .env avec des secrets réels

# =============================================================================
# POSTGRESQL (Airflow metadata & Keycloak)
# =============================================================================
POSTGRES_USER=ekg_admin
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_DB=ekg_meta
AIRFLOW_DB=airflow
KEYCLOAK_DB=keycloak

# =============================================================================
# APACHE AIRFLOW
# =============================================================================
# Générer Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
AIRFLOW_SECRET_KEY=airflow_secret_key_change_me_please_use_random_string
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# =============================================================================
# GRAPHDB (Triplestore)
# =============================================================================
GRAPHDB_URL=http://graphdb:7200
GRAPHDB_REPOSITORY=ekg
GRAPHDB_JAVA_OPTS=-Xmx2g -Xms1g

# =============================================================================
# KEYCLOAK (OIDC/AuthN)
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ekg
KEYCLOAK_CLIENT_ID=ekg-api
KEYCLOAK_CLIENT_SECRET=changeme_use_real_secret_from_keycloak_console

# =============================================================================
# API GATEWAY (NestJS)
# =============================================================================
NODE_ENV=development
API_PORT=3000

# =============================================================================
# GRAFANA
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Niveaux de log: debug, info, warn, error
LOG_LEVEL=info

# Trust score threshold (0.0 - 1.0)
TRUST_SCORE_THRESHOLD=0.3

# SHACL validation stricte (true/false)
SHACL_STRICT_MODE=true
