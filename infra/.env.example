# =============================================================================
# EKG - Enterprise Knowledge Graph
# Environment Configuration Template
# =============================================================================
#
# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Update the values as needed for your environment
# 3. DO NOT commit the .env file to version control
#

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
POSTGRES_USER=ekg_admin
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_DB=ekg_meta
AIRFLOW_DB=airflow
KEYCLOAK_DB=keycloak

# =============================================================================
# APACHE AIRFLOW
# =============================================================================
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Fernet key for encrypting secrets in Airflow
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=

# Secret key for Flask session
AIRFLOW_SECRET_KEY=airflow_secret_key_change_me

# =============================================================================
# GRAPHDB (RDF Triplestore)
# =============================================================================
GRAPHDB_URL=http://graphdb:7200
GRAPHDB_REPOSITORY=ekg

# =============================================================================
# KEYCLOAK (Authentication & Authorization)
# =============================================================================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ekg
KEYCLOAK_CLIENT_ID=ekg-api
KEYCLOAK_CLIENT_SECRET=changeme

# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =============================================================================
# NEO4J (Property Graph Database)
# =============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# =============================================================================
# API GATEWAY
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# NEO4J AUTO-SYNC SERVICE
# =============================================================================
# Sync interval in seconds (default: 30)
SYNC_INTERVAL=30

# =============================================================================
# MONITORING (Prometheus & Grafana)
# =============================================================================
# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# REDIS (Caching)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
