@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix ex: <http://example.com/schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#ProjectMapping>
  rml:logicalSource [
    rml:source "seed/projects.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "http://example.com/schema#{id}" ;
    rr:class ex:Project
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:name ;
    rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:description ;
    rr:objectMap [ rml:reference "description" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:startDate ;
    rr:objectMap [ rml:reference "startDate" ; rr:datatype xsd:date ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:endDate ;
    rr:objectMap [ rml:reference "endDate" ; rr:datatype xsd:date ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:managedBy ;
    rr:objectMap [ rr:template "http://example.com/schema#{managedById}" ; rr:termType rr:IRI ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:label ;
    rr:objectMap [ rr:template "http://example.com/schema#{label}" ; rr:termType rr:IRI ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:validFrom ;
    rr:objectMap [ rml:reference "validFrom" ; rr:datatype xsd:dateTime ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate prov:wasDerivedFrom ;
    rr:objectMap [ rr:constant "seed/projects.csv" ; rr:datatype xsd:string ]
  ] .
